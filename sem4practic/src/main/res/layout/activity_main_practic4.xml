<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center"
    tools:context=".MainActivityPractic4">

    <Button
        android:id="@+id/btnDeschideFormular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/adaug_imobil" />

    <Button
        android:id="@+id/btnVeziLista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vezi_lista"/>

    <Button
        android:id="@+id/btnDeschideFormularAi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/adaug_imobil_design_ai" />

    <TextView
        android:id="@+id/tvRezultat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/aici_va_ap_rea_imobilul_ad_ugat"
        android:textSize="16sp"
        android:textAlignment="center"/>

</LinearLayout>